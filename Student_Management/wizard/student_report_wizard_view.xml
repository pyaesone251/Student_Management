<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_report_wizard_form" model="ir.ui.view">
        <field name="name">student.report.wizard.form</field>
        <field name="model">student.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Student Report Wizard">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-danger" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_report_view" model="ir.actions.act_window">
        <field name="name">Student Report</field>
        <field name="res_model">student.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_student_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_student_report" name="Reporting" parent="student_management_root" sequence="10"/>

    <menuitem id="student_report" name="Student Reporting" parent="menu_student_report" action="action_student_report_view" sequence="10"/>
</odoo>
