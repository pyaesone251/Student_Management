<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_student" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Student_Management.report_student_document</field>
        <field name="report_file">Student_Management.report_student_document</field>
        <field name="print_report_name">'Student Report -%s' % (object.student_name)</field>
        <field name="binding_model_id" ref="model_school_student" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_student_document">
        <t t-call="web.html_container">
            <t t-set="company" t-value="res_company" />
            <t t-foreach="docs" t-as="o">
                <!-- Header -->
                <div class="header">
                    <div class="text-center border-bottom pb-2">
                        <!-- <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/> -->
                        <h3 class="text-center fw-bold" t-esc="company.name" />
                    </div>
                    <div class="text-center mt-2">
                        <h5 class="text-center fw-bold">STUDENT ID CARD</h5>
                    </div>
                </div>

                <!-- Body -->
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                    <div class="page">
                        <style>
                            .student-info-table, .student-info-table tr, .student-info-table td {
                                border: none !important;
                                border-collapse: collapse !important;
                            }
                        </style>
                        <div style="border: 1.5px solid #333;">
                        <table class="student-info-table" style="width: 100%; border-spacing: 0;">
                            <tr style="height: 36px;">
                                <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Student Name
                                </td>
                                <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.student_name"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Student ID
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.sequence"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Gender
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.gender"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Date of Birth
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.date_of_birth"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Class
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.class_id"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Academic Year
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-field="o.class_id.academic_year"/>
                                </td>
                            </tr>
                            <tr style="height: 36px;">
                                <td style="font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">
                                    Date of Issue
                                </td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">
                                    :
                                </td>
                                <td style="vertical-align: middle; padding: 6px 20px 6px 10px;">
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y')"/>
                                </td>
                            </tr>
                        </table>
                        </div>

                        <h3 style="text-align: center; margin-top: 20px;">SUBJECTS </h3>

                        <table style="width: 100%; border: 1px solid #777; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #d9e2f3;">
                                    <th style="width: 10%; border: 1px solid #777; padding: 7px; text-align: center;">No.</th>
                                    <th style="width: 20%; border: 1px solid #777; padding: 7px; text-align: center;">Subject Code</th>
                                    <th style="width: 38%; border: 1px solid #777; padding: 7px; text-align: center;"> Subject Name</th>
                                    <th style="width: 32%; border: 1px solid #777; padding: 7px; text-align: center;">Teacher</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="number" t-value="1"/>
                                <tr t-foreach="o.subject_ids" t-as="line">
                                    <td style="border: 1px solid #777; padding: 7px; text-align: center;">
                                        <span t-esc="number"/>
                                    </td>

                                    <td style="border: 1px solid #777; padding: 7px; text-align: center;">
                                        <span t-field="line.code"/>
                                    </td>

                                    <td style="border: 1px solid #777; padding: 7px; text-align: center;">
                                        <span t-field="line.name"/>
                                    </td>

                                    <td style="border: 1px solid #777; padding: 7px; text-align: center;">
                                        <span t-field="line.teacher_id.name"/>
                                    </td>
                                    <t t-set="number" t-value="number+1"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>


                <!-- Footer -->
                <!-- <div class="footer">
                    <div class="d-flex align-items-center border-top pt-2">
                        <span>Page <span class="page"/> / <span class="topage" /> </span>
                    </div>
                </div> -->
            </t>
        </t>
    </template>
</odoo>